# Secrets only. `python -m jobsift --setup` fills this in and checks each value;
# or copy it to .env and fill it in by hand. .env is gitignored — never commit it.

# ── LLM key ──
# You only need the key for the provider you set in config.yaml (llm_provider).
#   Anthropic: https://console.anthropic.com  → API keys
#   OpenAI:    https://platform.openai.com    → API keys
#
# THIS COSTS MONEY. Every job is read by the model at least once, and anything
# that survives the filters is read again to score it. One pass over a day of
# alert emails plus the scrape sources made ~150 calls here. Start with
# --once --no-telegram, read the CSV, and decide what a run is worth to you
# before putting it on a schedule.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Gmail inbox the watcher reads ──
# Use a Gmail App Password (Google Account → Security → 2-Step Verification →
# App passwords), NOT your real password. This avoids the whole OAuth setup.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Telegram alerts (optional) ──
# Bot token from @BotFather, chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
