# Secrets only. Copy to .env and fill in. .env is gitignored — never commit it.

# ── LLM key ──
# You only need the key for the provider you set in config.yaml (llm_provider).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Gmail inbox the watcher reads ──
# Use a Gmail App Password (Google Account → Security → 2-Step Verification →
# App passwords), NOT your real password. This avoids the whole OAuth setup.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Telegram alerts (optional) ──
# Bot token from @BotFather, chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
